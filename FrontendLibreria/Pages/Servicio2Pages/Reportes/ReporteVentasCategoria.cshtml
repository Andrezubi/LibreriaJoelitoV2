@page
@model FrontendLibreria.Pages.Servicio2Pages.Reportes.ReporteVentasCategoriaModel
@{
    ViewData["Title"] = "Reporte Ventas por Categoría";
}

<div class="reporte-container">
    <div class="reporte-header">
        <h2 class="reporte-titulo">Reporte de Ventas por Categoría</h2>
        <p class="reporte-subtitulo">Información sumariada con gráfico de distribución</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="reporte-error">⚠ @Model.Error</div>
    }

    <!-- Botón para abrir modal -->
    <button class="btn-generar" onclick="abrirModal()">
        Generar Reporte
    </button>

    <!-- MODAL -->
    <div id="modalReporte" class="modal-overlay" style="display:none">
        <div class="modal-card">
            <div class="modal-header">
                <span>Reporte Ventas por Categoría</span>
                <button onclick="cerrarModal()" class="modal-cerrar">✕</button>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="filtro-field">
                        <label>Fecha Desde</label>
                        <input type="date" name="FechaDesde" required
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="filtro-field">
                        <label>Fecha Hasta</label>
                        <input type="date" name="FechaHasta" required
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" name="Format" value="pdf" class="btn-pdf">
                        📄 Generar PDF
                    </button>
                    <button type="submit" name="Format" value="excel" class="btn-excel">
                        📊 Exportar Excel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .reporte-container {
        padding: 32px;
    }

    .reporte-titulo {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        color: #1a237e;
        font-size: 1.4rem;
    }

    .reporte-subtitulo {
        color: #888;
        font-size: 0.9rem;
        margin-bottom: 24px;
    }

    .reporte-error {
        background: #fdecea;
        color: #c62828;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    .btn-generar {
        background: #1a237e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 28px;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-generar:hover {
            background: #283593;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-card {
        background: #fff;
        border-radius: 14px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        overflow: hidden;
    }

    .modal-header {
        background: #1a237e;
        color: #fff;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        font-family: 'Poppins', sans-serif;
    }

    .modal-cerrar {
        background: none;
        border: none;
        color: #fff;
        font-size: 1.1rem;
        cursor: pointer;
    }

    .modal-body {
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .filtro-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filtro-field label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #333;
        }

        .filtro-field input {
            border: 1.5px solid #d0d7e2;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.95rem;
            font-family: 'Poppins', sans-serif;
            outline: none;
        }

            .filtro-field input:focus {
                border-color: #1a237e;
            }

    .modal-footer {
        padding: 16px 20px;
        display: flex;
        gap: 12px;
        border-top: 1px solid #eee;
    }

    .btn-pdf {
        flex: 1;
        background: #1a237e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 11px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-pdf:hover {
            background: #283593;
        }

    .btn-excel {
        flex: 1;
        background: #2e7d32;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 11px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-excel:hover {
            background: #388e3c;
        }
</style>

@section Scripts {
    <script>
        function abrirModal() {
            document.getElementById('modalReporte').style.display = 'flex';
        }
        function cerrarModal() {
            document.getElementById('modalReporte').style.display = 'none';
        }
        // Cerrar al hacer click fuera del modal
        document.getElementById('modalReporte').addEventListener('click', function(e) {
            if (e.target === this) cerrarModal();
        });
    </script>
}
