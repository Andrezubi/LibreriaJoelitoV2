@page
@model FrontendLibreria.Pages.Usuarios.CambiarContrasenaModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["OcultarSidebar"] = Model.EsPrimerLogin;
}

<div class="@(Model.EsPrimerLogin ? "cambio-forzado-wrapper" : "cambio-wrapper")">

    @if (Model.EsPrimerLogin)
    {
        <div class="alerta-primer-login">
            <span>⚠️</span>
            <span>Es tu primer inicio de sesión. Debes cambiar tu contraseña para continuar.</span>
        </div>
    }

    <div class="cambio-card">
        <h2 class="cambio-titulo">Cambiar Contraseña</h2>
        <p class="cambio-subtitulo">@User.Identity?.Name</p>

        @if (Model.Errores.Any())
        {
            <div class="cambio-errores">
                @foreach (var error in Model.Errores)
                {
                    <div>⚠ @error</div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.MensajeExito))
        {
            <div class="cambio-exito">✓ @Model.MensajeExito</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="cambio-field">
                <label>Contraseña actual</label>
                <input type="password" name="ContrasenaActual" required placeholder="Ingrese su contraseña actual" />
            </div>

            <div class="cambio-field">
                <label>Nueva contraseña</label>
                <input type="password" name="NuevaContrasena" id="nuevaContrasena" required placeholder="Mín. 8 caracteres" />
                <div class="politica">
                    <span id="p-longitud">✗ Mínimo 8 caracteres</span>
                    <span id="p-mayuscula">✗ 1 mayúscula</span>
                    <span id="p-minuscula">✗ 1 minúscula</span>
                    <span id="p-numero">✗ 1 número</span>
                    <span id="p-especial">✗ 1 carácter especial</span>
                </div>
            </div>

            <div class="cambio-field">
                <label>Confirmar nueva contraseña</label>
                <input type="password" name="ConfirmacionContrasena" id="confirmacion" required placeholder="Repita la nueva contraseña" />
                <span id="p-coincide" class="politica-item oculto">✗ Las contraseñas no coinciden</span>
            </div>

            <button type="submit" class="btn-cambiar">Guardar cambio</button>

            @if (!Model.EsPrimerLogin)
            {
                <a href="/Index" class="btn-cancelar">Cancelar</a>
            }
        </form>
    </div>
</div>

<style>
    .cambio-forzado-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f4f6fb;
        padding: 24px;
    }

    .cambio-wrapper {
        display: flex;
        justify-content: center;
        padding: 40px 24px;
    }

    .alerta-primer-login {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 14px 20px;
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
        align-items: center;
        max-width: 460px;
        width: 100%;
        font-weight: 500;
        color: #856404;
    }

    .cambio-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(0,0,0,0.10);
        padding: 40px;
        width: 100%;
        max-width: 460px;
    }

    .cambio-titulo {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 1.3rem;
        color: #1a237e;
        margin-bottom: 4px;
    }

    .cambio-subtitulo {
        color: #888;
        font-size: 0.88rem;
        margin-bottom: 24px;
    }

    .cambio-errores {
        background: #fdecea;
        color: #c62828;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.88rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .cambio-exito {
        background: #e8f5e9;
        color: #2e7d32;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-size: 0.88rem;
    }

    .cambio-field {
        display: flex;
        flex-direction: column;
        margin-bottom: 18px;
    }

        .cambio-field label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #333;
            margin-bottom: 6px;
        }

        .cambio-field input {
            border: 1.5px solid #d0d7e2;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.97rem;
            font-family: 'Poppins', sans-serif;
            outline: none;
            transition: border-color 0.2s;
        }

            .cambio-field input:focus {
                border-color: #1a237e;
            }

    .politica {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

        .politica span {
            font-size: 0.78rem;
            padding: 3px 8px;
            border-radius: 12px;
            background: #fdecea;
            color: #c62828;
            transition: all 0.2s;
        }

            .politica span.ok {
                background: #e8f5e9;
                color: #2e7d32;
            }

    .oculto {
        display: none !important;
    }

    .btn-cambiar {
        width: 100%;
        background: #1a237e;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'Poppins', sans-serif;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.2s;
    }

        .btn-cambiar:hover {
            background: #283593;
        }

    .btn-cancelar {
        display: block;
        text-align: center;
        margin-top: 12px;
        color: #888;
        font-size: 0.9rem;
        text-decoration: none;
    }

        .btn-cancelar:hover {
            color: #1a237e;
        }
</style>

@section Scripts {
    <script>
        const nueva = document.getElementById('nuevaContrasena');
        const confirma = document.getElementById('confirmacion');

        function validar() {
            const v = nueva.value;
            toggle('p-longitud',  v.length >= 8);
            toggle('p-mayuscula', /[A-Z]/.test(v));
            toggle('p-minuscula', /[a-z]/.test(v));
            toggle('p-numero',    /[0-9]/.test(v));
            toggle('p-especial',  /[!@@#$%^&*()_+\-=\[\]{}|;':",./<>?]/.test(v));

            const coincideEl = document.getElementById('p-coincide');
            if (confirma.value.length > 0) {
                coincideEl.classList.remove('oculto');
                toggle('p-coincide', v === confirma.value, '✓ Las contraseñas coinciden', '✗ Las contraseñas no coinciden');
            } else {
                coincideEl.classList.add('oculto');
            }
        }

        function toggle(id, ok, textoOk, textoFail) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.toggle('ok', ok);
            if (textoOk) el.textContent = ok ? textoOk : textoFail;
            else el.textContent = (ok ? '✓' : '✗') + el.textContent.substring(1);
        }

        nueva.addEventListener('input', validar);
        confirma.addEventListener('input', validar);
    </script>
}
