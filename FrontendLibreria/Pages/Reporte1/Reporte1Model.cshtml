@page
@model FrontendLibreria.Pages.Reporte1.Reporte1PageModel
@{
    ViewData["Title"] = "Reporte de Servicios";
}

<div class="container-fluid pt-4 px-4 bg-light min-vh-100">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        
        <div class="card-header text-center py-3 border-0" style="background-color: #6f42c1;">
            <h4 class="m-0 fw-bold text-white text-uppercase">Gestión de Reportes</h4>
        </div>

        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="text-dark fw-bold m-0">Lista de Servicios del Sistema</h5>
                <button onclick="window.print()" class="btn btn-success shadow-sm px-4 fw-bold rounded-3">
                    + Imprimir Reporte
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center mb-0">
                    <thead class="text-white" style="background-color: #6f42c1;">
                        <tr>
                            <th class="py-3">Usuario / Nro</th>
                            <th class="py-3">Nombre del Servicio</th>
                            <th class="py-3">Costo Bs.</th>
                            <th class="py-3">Descripción</th>
                            <th class="py-3">Categoría</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @foreach (var item in Model.ListaServicios)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Nro</td>
                                <td class="text-secondary">@item.NombreServicio</td>
                                <td>
                                    <span class="text-dark fw-bold">
                                        @item.CostoBs.ToString("N2")
                                    </span>
                                </td>
                                <td>@item.Descripcion</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill px-3 py-2 shadow-sm">
                                        @item.Categoria
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-5 pt-3 text-muted border-top">
                <p class="small">Página — 1 —</p>
                <p class="small fw-bold">Reporte Generado: admin - @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
            </div>
        </div>
    </div>
</div>